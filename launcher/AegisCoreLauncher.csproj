<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>AegisCore</AssemblyName>
    <RootNamespace>AegisCoreLauncher</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <ApplicationIcon>aegis.ico</ApplicationIcon>
    <Version>6.0.0</Version>
    <Product>AegisCore Endpoint Security</Product>
    <Company>AegisCore Security</Company>
    <FileDescription>AegisCore Endpoint Security Masaüstü Başlatıcı</FileDescription>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
